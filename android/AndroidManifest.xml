<?xml version="1.0" encoding="utf-8"?>
<!-- build.sh replaces ${APP_ID} (default: app.bookative). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.bookative">

    <!-- Only used to download images contained in pasted web content. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Bookative"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="app.bookative.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open or receive a backup made on another device -->
            <intent-filter android:label="Import into Bookative">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter android:label="Import into Bookative">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <provider
            android:name="app.bookative.ContentServer"
            android:authorities="${APP_ID}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
